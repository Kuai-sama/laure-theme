    "terminal.ansiBrightRed": "#d99a9a",
    "terminal.ansiBrightGreen": "#b7d69e",
    "terminal.ansiBrightYellow": "#e8c468",
    "terminal.ansiBrightBlue": "#9bc4bc",
    "terminal.ansiBrightMagenta": "#cbb0da",
    "terminal.ansiBrightCyan": "#bcdfd8",
