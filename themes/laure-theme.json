  "tokenColors": [
    {
      "settings": {
        "foreground": "#ecdfc3",
        "background": "#1b1712"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7d7460",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "constant.other.symbol"],
      "settings": {
        "foreground": "#a8c48a"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#e0a458"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#d4af37",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#cbb994"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#f0c987"
      }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "storage.type.class"],
      "settings": {
        "foreground": "#f4d58d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#cbb994"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#d9c79e"
      }
    },
    {
      "name": "Tags (HTML/JSX/XML)",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#d4af37"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#e0a458"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#a89a72"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#f4d58d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold/italic",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#f0c987",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#d9c79e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#8fb3a9"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#d98a8f",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#9bc4bc"
      }
    }
  ]
}
