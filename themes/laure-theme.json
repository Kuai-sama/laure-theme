    "peekViewEditor.background": "#0e1815",
    "peekViewResult.background": "#0e1815",
    "peekViewTitle.background": "#16231d"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#d8e2d3",
        "background": "#101c17"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5c7267",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "constant.other.symbol"],
      "settings": {
        "foreground": "#9bc48a"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#d98f4e"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#d4a949",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#9fb8a8"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#e0c07a"
      }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "storage.type.class"],
      "settings": {
        "foreground": "#f0cf6e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#c3d3bd"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#a9c4b3"
      }
    },
    {
      "name": "Tags (HTML/JSX/XML)",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#d4a949"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#d98f4e"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#7a9186"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#f0cf6e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold/italic",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#e0c07a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#a9c4b3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#7fa89c"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#c97a7a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#9bc4bc"
      }
    },
    {
      "name": "Python: True/False/None",
      "scope": ["constant.language.python"],
      "settings": { "foreground": "#d98f4e", "fontStyle": "italic" }
    },
    {
      "name": "Python: decorators",
      "scope": ["entity.name.function.decorator.python", "meta.function.decorator.python support.type.python", "punctuation.definition.decorator.python"],
      "settings": { "foreground": "#d98f4e", "fontStyle": "italic" }
    },
    {
      "name": "Python: self / cls",
      "scope": ["variable.parameter.function.language.special.self.python", "variable.parameter.function.language.special.cls.python", "variable.language.special.self.python"],
      "settings": { "foreground": "#b79bc9", "fontStyle": "italic" }
    },
    {
      "name": "Python: magic methods (dunder)",
      "scope": ["support.function.magic.python", "meta.function.python entity.name.function.magic"],
      "settings": { "foreground": "#e0c07a", "fontStyle": "italic" }
    },
    {
      "name": "Python: docstrings",
      "scope": ["string.quoted.docstring.multi.python", "string.quoted.docstring.python"],
      "settings": { "foreground": "#7fa89c", "fontStyle": "italic" }
    },
    {
      "name": "Python: f-strings",
      "scope": ["punctuation.definition.template-expression.python", "punctuation.section.embedded.python"],
      "settings": { "foreground": "#d98f4e" }
    },
    {
      "name": "Python: parameter names",
      "scope": ["variable.parameter.function.python"],
      "settings": { "foreground": "#c3d3bd", "fontStyle": "italic" }
    }
  ]
}