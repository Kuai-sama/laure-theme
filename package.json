{
  "name": "laure-vscode-dark-theme",
  "displayName": "Laurë Dark Theme",
  "description": "An elegant dark theme inspired by the golden light of Lothlórien. Warm amber tones, natural hues, and soft contrast designed for long coding sessions without eye strain.",
  "version": "1.1.8",
  "publisher": "Kuai",
  "license": "MIT",
  "keywords": [
      "laurë",
      "color-theme",
      "dark-theme",
      "vscode-theme",
      "theme",
      "syntax-highlighting",
      "developer-tools",
      "vscode",
      "vscode-extension",
      "tolkien",
      "jrrtolkien",
      "jrr-tolkien",
      "lord-of-the-rings",
      "lordoftherings",
      "lotr",
      "lothlorien",
      "elvish",
      "amber",
      "gold",
      "nature",
      "eye strain",
      "cozy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuai-sama/laure-theme"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Laurë (holt/wood)",
        "uiTheme": "vs-dark",
        "path": "./themes/laure-theme-holt.json"
      }
    ]
  },
  "scripts": {
    "lint": "bunx jsonlint -q themes/*.json package.json",
    "package": "bunx @vscode/vsce package --allow-missing-repository",
    "test": "bun run lint && bun run package",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
